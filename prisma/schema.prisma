generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

model Equipment {
  id            Int             @id @default(autoincrement())
  name          String
  category      String
  description   String?
  imageUrl      String?
  totalQuantity Int
  status        String          @default("active")
  requests      RentalRequest[]
  createdAt     DateTime        @default(now())
}

model RentalRequest {
  id            Int       @id @default(autoincrement())
  requestNumber String    @unique
  groupNumber   String?
  passwordHash  String
  applicantName String
  studentId     String
  phone         String
  equipmentId   Int
  equipment     Equipment @relation(fields: [equipmentId], references: [id])
  quantity      Int
  startAt       DateTime
  endAt         DateTime
  purpose       String?
  status        String    @default("pending")
  adminNote     String?
  returnedAt    DateTime?
  createdAt     DateTime  @default(now())
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String   @default("관리자")
  createdAt    DateTime @default(now())
}

model RateLimitAttempt {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model Classroom {
  id          Int                      @id @default(autoincrement())
  roomNumber  String                   @unique
  capacity    Int
  description String?
  equipment   String?                  // 예: "빔프로젝터, 화이트보드, 전자교탁"
  status      String                   @default("active")
  requests    ClassroomRentalRequest[]
  createdAt   DateTime                 @default(now())
}

model ClassroomRentalRequest {
  id                    Int       @id @default(autoincrement())
  requestNumber         String    @unique // ROOM-YYYYMMDD-XXXX
  passwordHash          String
  applicantName         String
  studentId             String
  phone                 String
  classroomId           Int
  classroom             Classroom @relation(fields: [classroomId], references: [id])
  startAt               DateTime
  endAt                 DateTime
  purpose               String?
  status                String    @default("pending") // pending, approved, rejected, returned
  adminNote             String?
  returnedAt            DateTime?
  hasDepartmentApproval Boolean   @default(false)
  createdAt             DateTime  @default(now())
}


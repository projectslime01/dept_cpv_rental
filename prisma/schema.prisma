generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Equipment {
  id            Int             @id @default(autoincrement())
  name          String
  category      String
  description   String?
  imageUrl      String?
  totalQuantity     Int
  minRentalQuantity Int          @default(1)
  maxRentalQuantity Int?
  minGrade      Int             @default(1)  // 대여 가능 최소 학년 (1/2/3)
  status        String          @default("active")
  createdAt     DateTime        @default(now())
  requests      RentalRequest[]
  accessories   EquipmentAccessory[]
}

model RentalRequest {
  id            Int       @id @default(autoincrement())
  requestNumber String    @unique
  groupNumber   String?
  passwordHash  String
  applicantName String
  studentId     String
  phone         String
  equipmentId   Int
  quantity      Int
  grade         Int?      // 신청자 학년 (1/2/3). 레거시/이전 데이터는 null
  startAt       DateTime
  endAt         DateTime
  purpose       String?
  // 팀플 과제 시 조원 이름(선택). 값이 있으면 팀 신청으로 본다.
  groupMembers  String?
  status        String    @default("pending")
  adminNote     String?
  returnedAt    DateTime?
  createdAt     DateTime  @default(now())
  equipment     Equipment @relation(fields: [equipmentId], references: [id])
  accessories   RentalRequestAccessory[]
  isTest      Boolean @default(false)
  testAdminId Int?
  testAdmin   Admin?  @relation("RentalTestAdmin", fields: [testAdminId], references: [id], onDelete: SetNull)
}

model EquipmentAccessory {
  id            Int                      @id @default(autoincrement())
  equipmentId   Int
  name          String
  description   String?
  totalQuantity Int
  // 같은 값을 가진 부속들은 물리적으로 동일한 재고 풀을 공유한다.
  // (예: FX3·A7M4가 함께 쓰는 배터리) null이면 단독 재고.
  sharedStockKey String?
  status        String                   @default("active")
  createdAt     DateTime                 @default(now())
  equipment     Equipment                @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  rentalItems   RentalRequestAccessory[]

  @@index([sharedStockKey])
}

model RentalRequestAccessory {
  id              Int                @id @default(autoincrement())
  rentalRequestId Int
  accessoryId     Int
  quantity        Int
  rentalRequest   RentalRequest      @relation(fields: [rentalRequestId], references: [id], onDelete: Cascade)
  accessory       EquipmentAccessory @relation(fields: [accessoryId], references: [id], onDelete: Restrict)

  @@unique([rentalRequestId, accessoryId])
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  name         String   @default("관리자")
  // owner: 다른 관리자 계정을 추가·삭제할 수 있다. staff: 자기 비밀번호만 변경 가능.
  // 새 계정은 기본이 staff 이므로 권한은 명시적으로만 올라간다.
  role         String   @default("staff")
  testRentalRequests    RentalRequest[]          @relation("RentalTestAdmin")
  testClassroomRequests ClassroomRentalRequest[] @relation("ClassroomTestAdmin")
}

model ClassroomRequest {
  id            Int      @id @default(autoincrement())
  requestNumber String   @unique
  passwordHash  String
  applicantName String
  studentId     String
  phone         String
  isGroup       Boolean  @default(false)
  groupCount    Int?
  groupMembers  String?
  startAt       DateTime
  endAt         DateTime
  purpose       String
  monitorAssets String
  status        String   @default("pending")
  adminNote     String?
  createdAt     DateTime @default(now())
}

model RentalRestriction {
  id          Int       @id @default(autoincrement())
  studentId   String    // 제한 대상 학번
  studentName String?   // 이름(선택, 식별용)
  reason      String    // 노쇼 / 손망실 / 연체 / 기타
  detail      String?   // 상세 사유 메모
  startAt     DateTime  @default(now())
  endAt       DateTime  // 제한 종료 시각 (이 시각 이후 자동 해제)
  releasedAt  DateTime? // 관리자 수동 해제 시각 (값이 있으면 즉시 해제됨)
  createdBy   Int?      // 등록한 관리자 id
  createdAt   DateTime  @default(now())

  @@index([studentId])
  @@index([endAt])
}

model RateLimitAttempt {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  attempts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

model Classroom {
  id          Int                      @id @default(autoincrement())
  roomNumber  String                   @unique
  capacity    Int
  description String?
  equipment   String?
  status      String                   @default("active")
  createdAt   DateTime                 @default(now())
  requests    ClassroomRentalRequest[]
  timetables  ClassroomTimetable[]
}

model ClassroomTimetable {
  id            Int       @id @default(autoincrement())
  classroomId   Int
  dayOfWeek     Int       // 0=월 1=화 2=수 3=목 4=금 5=토 6=일
  startTime     String    // "HH:MM" 24시 형식
  endTime       String    // "HH:MM" 24시 형식
  courseName    String?
  semesterStart DateTime
  semesterEnd   DateTime
  createdAt     DateTime  @default(now())
  classroom     Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
}

model ClassroomRentalRequest {
  id                    Int       @id @default(autoincrement())
  requestNumber         String    @unique
  passwordHash          String
  applicantName         String
  studentId             String
  phone                 String
  classroomId           Int
  startAt               DateTime
  endAt                 DateTime
  purpose               String?
  status                String    @default("pending")
  adminNote             String?
  returnedAt            DateTime?
  hasDepartmentApproval Boolean   @default(false)
  createdAt             DateTime  @default(now())
  groupCount            Int?
  groupMembers          String?
  isGroup               Boolean   @default(false)
  monitorAssets         String?
  classroom             Classroom @relation(fields: [classroomId], references: [id])
  isTest      Boolean @default(false)
  testAdminId Int?
  testAdmin   Admin?  @relation("ClassroomTestAdmin", fields: [testAdminId], references: [id], onDelete: SetNull)
}

model Student {
  studentId  String   @id
  name       String
  grade      Int
  className  String?
  // 학과·전공. 명단 업로드 시 교체 범위를 가르는 기준 (전공별 명부를 따로 올릴 수 있다)
  major      String?
  status     String   @default("active")
  source     String   @default("upload")
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([major])
}

model StudentRosterUpload {
  id          Int      @id @default(autoincrement())
  fileName    String
  totalRows   Int
  added       Int
  updated     Int
  deactivated Int
  uploadedBy  Int?
  createdAt   DateTime @default(now())
}
